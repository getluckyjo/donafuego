# Copy to .env and fill in — never commit the real .env file.

# Long-lived System User access token from Meta Business Settings
# (Business Settings > Users > System Users > generate token, with
# ads_read permission on the ad account below). A personal user token
# also works but expires in ~60 days.
META_ACCESS_TOKEN=

# Numeric ad account id, no "act_" prefix (find it in Ads Manager > account dropdown)
META_AD_ACCOUNT_ID=

# Graph API version — bump this occasionally as Meta deprecates old ones
META_API_VERSION=v21.0

# Lookback window for the insights pull: today, yesterday, last_7d, last_14d, last_30d
META_DATE_PRESET=last_7d

# Anthropic API key — or leave unset if you're logged in via `ant auth login`
ANTHROPIC_API_KEY=
